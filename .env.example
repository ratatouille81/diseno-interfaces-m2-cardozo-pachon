# Copia este archivo como .env y llena los valores. El archivo .env nunca se sube a GitHub.

# Supabase: URL del proyecto y clave pública (anon). La clave anon está pensada para el navegador
# y queda protegida por las reglas de seguridad por fila (RLS).
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Gemini: SIN el prefijo VITE_ a propósito, para que Vite no la meta en el código del navegador.
# Solo la usa la función serverless de Vercel.
GEMINI_API_KEY=

# Opcional: modelo de Gemini. Si no se define, se usa gemini-3.5-flash-lite.
# GEMINI_MODEL=gemini-3.5-flash-lite
